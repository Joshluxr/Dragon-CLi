{
  "name": "@dragon/supermemory",
  "version": "1.0.0",
  "description": "Local-only persistent memory system for Claude sessions",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./services/*": "./src/services/*.ts",
    "./cache/*": "./src/cache/*.ts",
    "./tree/*": "./src/tree/*.ts",
    "./embeddings/*": "./src/embeddings/*.ts"
  },
  "scripts": {
    "build": "pnpm build:hooks && pnpm build:commands",
    "build:hooks": "node --import tsx scripts/build-hooks.ts",
    "build:commands": "node --import tsx scripts/build-commands.ts",
    "tsc-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@dragon/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
